{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "size",
        "maxBytes",
        "existingClaim",
        "storageClass"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "pvc",
            "emptyDir"
          ]
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}(Mi|Gi|Ti)$"
        },
        "maxBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,12}$"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "registryAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials",
        "rules"
      ],
      "properties": {
        "credentials": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]([-a-z0-9]{0,38}[a-z0-9])?$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "onePasswordItemPath"
              ],
              "properties": {
                "onePasswordItemPath": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "registry",
              "credential"
            ],
            "properties": {
              "registry": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string"
              },
              "tokenURL": {
                "type": "string",
                "pattern": "^https://"
              },
              "credential": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
